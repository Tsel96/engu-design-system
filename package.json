{
  "name": "engu-design-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate": "node scripts/generate-code-connect.js",
    "publish": "figma connect publish",
    "sync-tokens": "node scripts/export-figma-tokens.js",
    "push-tokens": "node scripts/import-figma-tokens.js",
    "build:tokens": "node scripts/export-figma-tokens.js --input tokens/figma-variables.json",
    "check:tokens": "node scripts/export-figma-tokens.js --input tokens/figma-variables.json --check",
    "build:plugin": "node scripts/build-figma-plugin.js",
    "check:plugin": "node scripts/build-figma-plugin.js --check",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.3.0"
  }
}
